@implements IDisposable
@using LlamaShears.Core
@using LlamaShears.Core.Abstractions.Agent.Sessions
@inject IAgentDirectory Directory
@inject IAgentInstanceRepository Repository
@inject IChatSession Session
@inject NavigationManager Nav
@inject IJSRuntime Js

<div class="chat-header">
    <select id="agent-select" value="@Session.SelectedAgentId" @onchange="OnSelectionChangedAsync">
        @if (Session.SelectedAgentId is null)
        {
            <option value="">— select agent —</option>
        }
        @foreach (var id in _agentIds)
        {
            <option value="@id">@id</option>
        }
    </select>
    <select id="session-select" value="@_selectedSessionGuid">
        @if (_sessions.Count == 0)
        {
            <option value="">— no sessions —</option>
        }
        else
        {
            @foreach (var session in _sessions)
            {
                <option value="@session.Id">@session.Name - @session.Id</option>
            }
        }
    </select>
    @if (_agentIds.Count == 0)
    {
        <span class="chat-header-empty">No agents loaded yet.</span>
    }
    <div class="chat-header-actions">
        <button type="button" class="chat-header-button" title="Refresh" aria-label="Refresh agents" @onclick="Refresh">
            <Icon Name="arrow-clockwise" />
        </button>
        @if (Session.SelectedAgentId is { } selectedAgentId)
        {
            <a class="chat-header-button"
               title="Edit agent config"
               aria-label="Edit agent config"
               href="/agents/@Uri.EscapeDataString(selectedAgentId)/edit">
                <Icon Name="pencil-square" />
            </a>
        }
        <span class="chat-header-sep" aria-hidden="true"></span>
        <button type="button"
                class="chat-header-button chat-header-toggle @(Session.ShowThoughts ? "is-on" : null)"
                title="@(Session.ShowThoughts ? "Hide thinking" : "Show thinking")"
                aria-label="Toggle thinking visibility"
                aria-pressed="@(Session.ShowThoughts ? "true" : "false")"
                @onclick="ToggleThoughts">
            <Icon Name="lightbulb-fill" />
        </button>
        <button type="button"
                class="chat-header-button chat-header-toggle @(Session.ShowStreaming ? "is-on" : null)"
                title="@(Session.ShowStreaming ? "Hide streaming output" : "Show streaming output")"
                aria-label="Toggle streaming output"
                aria-pressed="@(Session.ShowStreaming ? "true" : "false")"
                @onclick="ToggleStreaming">
            <Icon Name="broadcast" />
        </button>
        <button type="button"
                class="chat-header-button chat-header-toggle @(Session.ShowTools ? "is-on" : null)"
                title="@(Session.ShowTools ? "Hide tool activity" : "Show tool activity")"
                aria-label="Toggle tool activity"
                aria-pressed="@(Session.ShowTools ? "true" : "false")"
                @onclick="ToggleTools">
            <Icon Name="tools" />
        </button>
        <select id="message-limit-select"
                class="chat-header-select"
                title="Maximum messages to display"
                aria-label="Message limit"
                value="@Session.MessageLimit"
                @onchange="OnMessageLimitChangedAsync">
            @foreach (var option in _messageLimitOptions)
            {
                <option value="@option">@option</option>
            }
        </select>
    </div>
</div>

@code {
    private static readonly int[] _messageLimitOptions = [10, 25, 50, 100, 500, 1000];

    private IReadOnlyList<string> _agentIds = [];
    private IReadOnlyList<SessionId> _sessions = [];
    private Guid? _selectedSessionGuid;
    private string? _loadedPrefsAgentId;

    protected override void OnInitialized()
    {
        Session.Changed += HandleChanged;
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var current = Session.SelectedAgentId;
        if (current is null || string.Equals(current, _loadedPrefsAgentId, StringComparison.Ordinal))
        {
            return;
        }
        _loadedPrefsAgentId = current;
        var thoughts = await ReadBoolAsync(ThoughtsKey(current));
        var streaming = await ReadBoolAsync(StreamingKey(current));
        var tools = await ReadBoolAsync(ToolsKey(current));
        var limit = await ReadIntAsync(MessageLimitKey(current));
        if (thoughts is bool t)
        {
            Session.ShowThoughts = t;
        }
        if (streaming is bool s)
        {
            Session.ShowStreaming = s;
        }
        if (tools is bool to)
        {
            Session.ShowTools = to;
        }
        if (limit is int l)
        {
            Session.MessageLimit = l;
        }
    }

    private void HandleChanged() => _ = InvokeAsync(StateHasChanged);

    private void Refresh()
    {
        _agentIds = Directory.ListAgentIds();
        RefreshSessions();
    }

    private void RefreshSessions()
    {
        if (Session.SelectedAgentId is not { } agentId)
        {
            _sessions = [];
            _selectedSessionGuid = null;
            return;
        }
        var matches = new List<SessionId>();
        SessionId? defaultSession = null;
        foreach (var handle in Repository.GetAllAgents())
        {
            if (!handle.SessionPath.IsRootSession) continue;
            var current = handle.SessionPath.Current;
            if (!string.Equals(current.AgentId, agentId, StringComparison.OrdinalIgnoreCase)) continue;
            matches.Add(current);
            if (current.IsDefault)
            {
                defaultSession = current;
            }
        }
        _sessions = matches;
        _selectedSessionGuid = defaultSession?.Id ?? matches.FirstOrDefault()?.Id;
    }

    private async Task ToggleThoughts()
    {
        Session.ShowThoughts = !Session.ShowThoughts;
        if (Session.SelectedAgentId is { } id)
        {
            await WriteBoolAsync(ThoughtsKey(id), Session.ShowThoughts);
        }
    }

    private async Task ToggleStreaming()
    {
        Session.ShowStreaming = !Session.ShowStreaming;
        if (Session.SelectedAgentId is { } id)
        {
            await WriteBoolAsync(StreamingKey(id), Session.ShowStreaming);
        }
    }

    private async Task ToggleTools()
    {
        Session.ShowTools = !Session.ShowTools;
        if (Session.SelectedAgentId is { } id)
        {
            await WriteBoolAsync(ToolsKey(id), Session.ShowTools);
        }
    }

    private async Task OnMessageLimitChangedAsync(ChangeEventArgs e)
    {
        if (e.Value is not string raw || !int.TryParse(raw, out var value))
        {
            return;
        }
        Session.MessageLimit = value;
        if (Session.SelectedAgentId is { } id)
        {
            await WriteIntAsync(MessageLimitKey(id), Session.MessageLimit);
        }
    }

    private async Task OnSelectionChangedAsync(ChangeEventArgs e)
    {
        var id = e.Value as string;
        var normalized = string.IsNullOrWhiteSpace(id) ? null : id;
        SessionId? session = null;
        if (normalized is not null
            && Repository.TryGetDefaultSession(normalized, out var sessionId)
            && Repository.TryGetAgent(sessionId, out var handle))
        {
            session = handle.SessionPath.Current;
        }
        await Session.SelectSessionAsync(session, CancellationToken.None);
        RefreshSessions();
        Nav.NavigateTo(normalized is null ? "/chat" : $"/chat/{Uri.EscapeDataString(normalized)}");
    }

    private async ValueTask<bool?> ReadBoolAsync(string key)
    {
        var raw = await Js.InvokeAsync<string?>("localStorage.getItem", key);
        return bool.TryParse(raw, out var v) ? v : null;
    }

    private ValueTask WriteBoolAsync(string key, bool value)
        => Js.InvokeVoidAsync("localStorage.setItem", key, value ? "true" : "false");

    private async ValueTask<int?> ReadIntAsync(string key)
    {
        var raw = await Js.InvokeAsync<string?>("localStorage.getItem", key);
        return int.TryParse(raw, out var v) ? v : null;
    }

    private ValueTask WriteIntAsync(string key, int value)
        => Js.InvokeVoidAsync("localStorage.setItem", key, value.ToString(System.Globalization.CultureInfo.InvariantCulture));

    private static string ThoughtsKey(string agentId) => $"llamashears:agent:{agentId}:showThoughts";

    private static string StreamingKey(string agentId) => $"llamashears:agent:{agentId}:showStreaming";

    private static string ToolsKey(string agentId) => $"llamashears:agent:{agentId}:showTools";

    private static string MessageLimitKey(string agentId) => $"llamashears:agent:{agentId}:messageLimit";

    public void Dispose()
    {
        Session.Changed -= HandleChanged;
    }
}
